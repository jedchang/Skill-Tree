{
  "liveSassCompile.settings.excludeList": ["/**/node_modules/**", "/.vscode/**", "/**/backup/**", "/**/reference/**"],
  "liveSassCompile.settings.autoprefix": ["> 1%", "last 2 versions", "ie >= 10"],
  "liveSassCompile.settings.generateMap": true,
  "liveSassCompile.settings.formats": [
    {
      "format": "compressed",
      "extensionName": ".min.css",
      "savePath": "/css"
    }
  ],
  "cSpell.words": ["Colorstr", "Flexbox", "NOOB", "OOCSS", "PREPROCESSORS", "SMACSS"]
}
